{
  "name": "auto-cal",
  "version": "0.1.0",
  "private": true,
  "description": "Poll a Gmail label, extract events with Claude, write to Google Calendar.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/handler.mjs --external:@aws-sdk/* --banner:js='import{createRequire}from\"module\";const require=createRequire(import.meta.url);'",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "get-refresh-token": "node --experimental-strip-types scripts/get-refresh-token.ts",
    "analyze": "node --experimental-strip-types scripts/analyze.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "googleapis": "^144.0.0",
    "ical.js": "^2.1.0",
    "node-html-parser": "^6.1.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
